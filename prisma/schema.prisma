generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppUserMetaData {
  userId   String  @id @map("user_id")
  referer  String?
  fromList String? @map("from_list")
  appUser  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_user_meta_data")
}

model BookGoodreadsRawData {
  bookId  Int     @id @map("book_id")
  rawData String? @map("raw_data")

  @@map("book_goodreads_raw_data")
}

model BookImportStatus {
  id           Int       @id @default(autoincrement()) @map("id")
  importId     Int?      @map("import_id")
  bookId       Int?      @map("book_id")
  importStatus String?   @map("import_status") @db.VarChar
  bookTitle    String?   @map("book_title") @db.VarChar
  bookAuthor   String?   @map("book_author") @db.VarChar
  errorDetails String?   @map("error_details")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @map("updated_at")
  isDeleted    Boolean?  @default(false) @map("is_deleted")

  @@map("book_import_status")
}

model BookInListVisit {
  visitId   Int      @id @default(autoincrement()) @map("visit_id")
  visitorId String?  @map("visitor_id")
  listId    String   @map("list_id")
  bookId    Int      @map("book_id")
  visitedAt DateTime @default(now()) @map("visited_at")
  book      Book     @relation(fields: [bookId], references: [bookId], onDelete: Cascade, onUpdate: NoAction)
  appUser   User? @relation(fields: [visitorId], references: [id])

  @@map("book_in_list_visits")
}

model BookVisit {
  visitId   Int      @id @default(autoincrement()) @map("visit_id")
  visitorId String?  @map("visitor_id")
  bookId    Int      @map("book_id")
  visitedAt DateTime @default(now()) @map("visited_at")
  book      Book     @relation(fields: [bookId], references: [bookId], onDelete: Cascade, onUpdate: NoAction)
  appUser   User? @relation(fields: [visitorId], references: [id])

  @@map("book_visits")
}

model BooksImport {
  id        Int       @id @default(autoincrement()) @map("id")
  userId    String?   @map("user_id") @db.VarChar
  startTime DateTime? @default(now()) @map("start_time") @db.Timestamptz(6)
  endTime   DateTime? @map("end_time") @db.Timestamptz(6)
  status    String?   @map("status") @db.VarChar
  isDeleted Boolean?  @default(false) @map("is_deleted")
  message   String?   @map("message") @db.VarChar
  appUser   User?  @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@map("books_import")
}

model GoodreadsData {
  goodreadsRating       Float?    @map("goodreads_rating")
  goodreadsUrl          String?   @map("goodreads_url")
  goodreadsRatingsCount Int?      @map("goodreads_ratings_count")
  updatedAt             DateTime? @map("updated_at")
  status                String?
  bookId                Int       @id @map("book_id")
  book                  Book      @relation(fields: [bookId], references: [bookId], onDelete: Cascade, onUpdate: NoAction)

  @@map("goodreads_data")
}

model ListVisit {
  visitId   Int       @id @default(autoincrement()) @map("visit_id")
  visitorId String?   @map("visitor_id")
  listId    String    @map("list_id")
  visitedAt DateTime  @default(now()) @map("visited_at")
  booksList BooksList @relation(fields: [listId], references: [listId])
  appUser   User?  @relation(fields: [visitorId], references: [id])

  @@map("list_visits")
}

model ReadingStatus {
  readingStatusId Int        @id @default(autoincrement()) @map("reading_status_id")
  statusName      String     @map("status_name")
  userBooks       UserBook[]

  @@map("reading_status")
}

model Role {
  roleId   Int    @id @default(autoincrement()) @map("role_id")
  roleName String @map("role_name")

  @@map("role")
}

model User {
  id            String    @id @default(cuid()) @unique @map("user_id")
  name          String?   @map("display_name")
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?   @map("profile_picture_url")

  bio           String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  gender        String?
  isDeleted     Boolean   @default(false) @map("is_deleted")
  goodreadsId   String?   @map("goodreads_id")
  roleId        Int?      @map("role_id")

  appUserMetaData    AppUserMetaData?
  bookInListVisits   BookInListVisit[]
  bookVisits         BookVisit[]
  booksImport        BooksImport[]
  booksList          BooksList[]
  listVisits         ListVisit[]
  userBooks          UserBook[]
  userBooksListMatch UserBooksListMatch[]
  Account            Account[]
  Session            Session[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_app_user_display_name_trgm", type: Gin)
  @@map("app_user")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Book {
  bookId                Int               @id @default(autoincrement()) @map("book_id")
  title                 String
  subtitle              String?
  language              String?
  numberOfPages         Int?              @map("number_of_pages")
  isbn                  String?
  thumbnailUrl          String?           @map("thumbnail_url")
  mediumImageUrl        String?           @map("medium_image_url")
  genres                String[]
  isbn10                String?           @map("isbn10")
  datePublished         DateTime?         @map("date_published") @db.Date
  originalDatePublished DateTime?         @map("original_date_published") @db.Date
  authors               String[]
  description           String?
  publisher             String?
  isDeleted             Boolean?          @default(false) @map("is_deleted")
  createdAt             DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  thumbnailColor        String?           @map("thumbnail_color")
  bookInList            BookInList[]
  bookInListVisits      BookInListVisit[]
  bookVisits            BookVisit[]
  goodreadsData         GoodreadsData?
  userBooks             UserBook[]

  @@index([genres], map: "idx_book_genres")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idx_book_title_trgm", type: Gin)
  @@map("book")
}

model BookInList {
  listId    String    @map("list_id")
  bookId    Int       @map("book_id")
  comments  String?
  updatedAt DateTime? @map("updated_at")
  createdAt DateTime? @default(now()) @map("created_at")
  position  Int       @default(0)
  book      Book      @relation(fields: [bookId], references: [bookId], onDelete: Cascade, onUpdate: NoAction)
  booksList BooksList @relation(fields: [listId], references: [listId], onDelete: Cascade, onUpdate: NoAction)

  @@id([listId, bookId])
  @@map("book_in_list")
}

model BooksList {
  listId             String               @id @unique @map("list_id")
  userId             String               @map("user_id")
  description        String?              @map("description")
  publicUrl          String?              @unique @map("public_url")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @map("updated_at")
  listName           String               @map("list_name")
  isVisible          Boolean              @default(true) @map("is_visible")
  publishedAt        DateTime?            @map("published_at")
  expiresAt          DateTime?            @map("expires_at")
  isDeleted          Boolean              @default(false) @map("is_deleted")
  genres             String[]             @map("genres")
  isGenresEditable   Boolean              @default(true) @map("is_genres_editable")
  visitsCount        Int                  @default(0) @map("visits_count")
  bookInList         BookInList[]
  appUser            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listVisits         ListVisit[]
  userBooksListMatch UserBooksListMatch[]

  @@unique([userId, listName], map: "list_userId_listName_key")
  @@index([listName(ops: raw("gin_trgm_ops"))], map: "idx_books_list_name_trgm", type: Gin)
  @@index([genres], map: "list_genres_index")
  @@index([listName], map: "list_name_index")
  @@map("books_list")
}

model UserBook {
  userBookId        Int           @id @default(autoincrement()) @map("user_book_id")
  userId            String        @map("user_id")
  bookId            Int           @map("book_id")
  readingStatusId   Int           @default(2) @map("reading_status_id")
  suggestionSource  String?       @map("suggestion_source")
  userComments      String?       @map("user_comments")
  dateAdded         DateTime      @map("date_added")
  userRating        Float?        @map("user_rating")
  readingStartDate  DateTime?     @map("reading_start_date")
  readingFinishDate DateTime?     @map("reading_finish_date")
  isDeleted         Boolean       @default(false) @map("is_deleted")
  isFavorite        Boolean       @default(false) @map("is_favorite")
  book              Book          @relation(fields: [bookId], references: [bookId], onDelete: Cascade, onUpdate: NoAction)
  readingStatus     ReadingStatus @relation(fields: [readingStatusId], references: [readingStatusId])
  appUser           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId], map: "user_book_bookId_userId_key")
  @@map("user_book")
}

model UserBooksListMatch {
  id        Int       @id @default(autoincrement()) @map("id")
  userId    String    @map("user_id")
  listId    String    @map("list_id")
  matchRate Float?    @map("match_rate")
  updatedAt DateTime  @map("updated_at")
  booksList BooksList @relation(fields: [listId], references: [listId])
  appUser   User   @relation(fields: [userId], references: [id])

  @@unique([userId, listId])
  @@map("user_books_list_match")
}